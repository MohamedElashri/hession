{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hession",
  "version": "0.4.0",
  "identifier": "io.github.mohamedelashri.hession",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hession",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0d0f12",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline' https:; font-src 'self' https: data:; media-src 'self' https:; script-src 'self' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "A local-first home for your coding agent sessions, local and remote.",
    "longDescription": "Hession is a local-first desktop app for browsing, searching, and analyzing your coding agent sessions on this machine and on your SSH hosts."
  },
  "mainBinaryName": "hession",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0QzAzQ0UyRDBEMERGRDMKUldUVDM5RFE0anpBWklpMlQ0YVM0Zk1MR21tTFlxa09zdVhrU01Kd2RYWWx6RCtMVlViQzRsWHYK",
      "endpoints": [
        "https://github.com/MohamedElashri/hession/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
