{
  "name": "hession",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "tauri": "node scripts/brand.mjs && tauri",
    "check": "node scripts/brand.mjs && npm run build && cargo check --manifest-path src-tauri/Cargo.toml",
    "brand": "node scripts/brand.mjs",
    "icons": "node scripts/icons.mjs",
    "lint": "eslint .",
    "unused": "knip",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test 'src/**/*.test.js' '.github/scripts/*.test.mjs'",
    "test:components": "vitest run",
    "test:coverage": "vitest run --coverage",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "knip": "^6.42.1",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}
